{
  "name": "nocodb-root",
  "version": "1.0.0",
  "engines": {
    "node": "22.x",
    "pnpm": ">=8.x"
  },
  "description": "NocoDB Root (Monorepo)",
  "private": true,
  "author": {
    "name": "NocoDB Inc",
    "url": "https://nocodb.com/"
  },
  "homepage": "https://github.com/nocodb/nocodb",
  "repository": {
    "type": "git",
    "url": "https://github.com/nocodb/nocodb.git"
  },
  "bugs": {
    "url": "https://github.com/nocodb/nocodb/issues"
  },
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "husky": "^8.0.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pnpm dlx lint-staged"
    }
  },
  "lint-staged": {
    "scripts/playwright/**/*.{ts,tsx,js,json}": [
      "pnpm run lint-staged:playwright"
    ]
  },
  "scripts": {
    "bootstrap": "pnpm install --hoist",
    "prebuild": "pnpm --filter=nocodb-sdk run build",
    "build": "pnpm --filter=nc-gui run build && pnpm --filter=nocodb run build && pnpm run integrations:build",
    "integrations:build": "pnpm --filter=nocodb-integrations run build",
    "start:frontend": "pnpm --filter=nc-gui run dev",
    "start:backend": "pnpm --filter=nocodb run start",
    "lint-staged:playwright": "cd ./tests/playwright; pnpm dlx lint-staged; cd -",
    "prepare": "husky install",
    "registerIntegrations": "pnpm --filter=nocodb run registerIntegrations",
    "vercel-build": "pnpm build"
  },
  "workspaces": [
    "packages/*",
    "tests/playwright"
  ],
  "dependencies": {},
  "vercel": {
    "buildCommand": "pnpm vercel-build",
    "outputDirectory": "packages/nc-gui/.nuxt/dist",
    "installCommand": "pnpm install --hoist",
    "nodeVersion": "22.x"
  }
}