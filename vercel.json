{
  "version": 2,
  "buildCommand": "cd packages/nc-gui && pnpm run frontend:build",
  "outputDirectory": "packages/nc-gui/.output",
  "installCommand": "pnpm install --no-hoist",
  "framework": "nuxtjs",
  "workspace": {
    "root": true,
    "packages": ["packages/*"]
  },
  "build": {
    "env": {
      "NODE_ENV": "production",
      "NUXT_BUILD_TARGET": "vercel"
    }
  }
}